{
  "name": "nucleus-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nucleus — 用一段话生成可运行网页应用的 AI Agent 工作台",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "esbuild server/main.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external --watch",
    "build:client": "vite build",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external --log-level=warning",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "serve": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "make:factory": "esbuild scripts/make-factory.ts --bundle --platform=node --format=esm --outfile=.tmp-factory/run.mjs --log-level=warning && node .tmp-factory/run.mjs",
    "key": "esbuild scripts/set-key.ts --bundle --platform=node --format=esm --outfile=.tmp-key/run.mjs --log-level=warning && node .tmp-key/run.mjs",
    "deploy:prepare": "node scripts/deploy.mjs",
    "e2e": "node scripts/e2e.mjs",
    "demo": "node scripts/demo-capture.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.24.2",
    "playwright": "^1.49.1",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vitest": "^2.1.9"
  }
}
