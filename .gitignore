# 依赖
node_modules/

# 构建产物
dist/
*.tsbuildinfo

# 运行时数据（首次启动自动重建并写入种子项目）
data/
.tmp-*/
tmpdbg/

# 测试产物
e2e-failure.png
coverage/

# 本地环境
.env
.env.local
*.log
.DS_Store
Thumbs.db

# 部署产物：由 npm run deploy:prepare 生成，内含密钥，不入库
deploy/start.sh
deploy/start-command.txt

# 编辑器
.vscode/
.idea/

# WorkBuddy 应用发布标记与大文件缓存
.wbapp_*.genie
.workbuddy/

# 沙箱内为绕过 git dubious-ownership 生成的临时配置（不属于项目）
.gitconfig-sandbox
